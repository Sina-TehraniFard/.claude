# macOS
.DS_Store

# IDE設定
.idea/
.vscode/

# セッション環境変数（機密情報を含む）
session-env/

# セッション履歴（入力内容が含まれる）
history.jsonl

# プラグイン設定（環境固有）
plugins/

# デバッグファイル
debug/
*.log

# ファイル履歴（セッション固有）
file-history/

# 統計情報
statsig/
stats-cache.json

# テレメトリ（device_id等の識別子を含む）
telemetry/

# シェルスナップショット
shell-snapshots/

# TODOファイル（セッション固有）
todos/

# プロジェクト固有の一時データ
projects/

# その他の一時ファイル
*.tmp
*.swp
*~

# 認証・トークン関連
*.token
*.key
*.pem
.env
.env.*
.credentials.json
settings.local.json
settings.json
secrets/
mcp.json

# IDE一時ファイル
ide/

*-cache
cache
plans

# Pythonキャッシュ
__pycache__/

# ローカル環境固有
powerline/
tasks/

# 自動生成バックアップ・使用統計
backups/
usage-data/
sessions/
*.bak
.last-cleanup
.last-update-result.json
mcp-needs-auth-cache.json
security/

# ランタイムのデーモン・ジョブ管理（PID・認証キー等を含む一時状態）
daemon.lock
daemon.status.json
daemon/
jobs/

# 通知システムのコンパイル済みバイナリ（setup.shで再生成）
hooks/bin/
# 通知システムの実行時状態
hooks/state/

# ローカル環境固有の接続情報（IP等）
local.env
