{
  "theme": "custom",
  "display": {
    "style": "capsule",
    "charset": "unicode",
    "padding": 0,
    "lines": [
      {
        "segments": {
          "directory": { "enabled": true, "style": "basename" },
          "git": { "enabled": true, "showWorkingTree": false }
        }
      },
      {
        "segments": {
          "context": { "enabled": true, "displayStyle": "ball", "showPercentageOnly": true, "percentageMode": "remaining" },
          "block": { "enabled": true, "displayStyle": "ball", "type": "time", "burnType": "none" },
          "weekly": { "enabled": true, "displayStyle": "ball" }
        }
      }
    ]
  },
  "colors": {
    "custom": {
      "directory":       { "bg": "#2a2a2a", "fg": "#e0e0e0" },
      "context":         { "bg": "#2a2a2a", "fg": "#ffc799" },
      "contextWarning":  { "bg": "#2a2a2a", "fg": "#c4a97e" },
      "contextCritical": { "bg": "#332020", "fg": "#ff8080" },
      "block":           { "bg": "#2a2a2a", "fg": "#9db4cc" },
      "weekly":          { "bg": "#2a2a2a", "fg": "#87a987" },
      "git":             { "bg": "#2a2a2a", "fg": "#8a8a8a" },
      "model":           { "bg": "#2a2a2a", "fg": "#b0b0b0" },
      "session":         { "bg": "#2a2a2a", "fg": "#6e6e6e" },
      "today":           { "bg": "#2a2a2a", "fg": "#6e6e6e" },
      "metrics":         { "bg": "#2a2a2a", "fg": "#6e6e6e" },
      "version":         { "bg": "#2a2a2a", "fg": "#6e6e6e" },
      "tmux":            { "bg": "#2a2a2a", "fg": "#6e6e6e" },
      "env":             { "bg": "#2a2a2a", "fg": "#6e6e6e" }
    }
  }
}
