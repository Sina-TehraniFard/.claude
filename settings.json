{
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Bash",
      "Read",
      "Edit",
      "Write"
    ],
    "deny": [
      "Bash(git push:*)",
      "Read(*.token)",
      "Read(*.key)",
      "Read(*.pem)",
      "Read(**/id_rsa)",
      "Read(**/id_dsa)",
      "Read(**/.ssh/id_*)"
    ],
    "ask": [
      "Bash(rm:*)",
      "Bash(rm -rf:*)",
      "Bash(rm -r:*)",
      "Edit(*env*)",
      "Edit(*.env)",
      "Edit(*.env.*)",
      "Write(*env*)",
      "Write(*.env)",
      "Write(*.env.*)"
    ],
    "disableBypassPermissionsMode": "disable"
  },
  "enabledPlugins": {
    "php-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "github@claude-plugins-official": true,
    "development-backend@asken-claude-code-marketplace": true,
    "development-mobile@asken-claude-code-marketplace": true
  },
  "language": "日本語"
}
