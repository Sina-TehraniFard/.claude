{
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(git fetch:*)",
      "Bash(git pull:*)",
      "Bash(ls:*)",
      "Bash(cd:*)",
      "Bash(pwd:*)",
      "Bash(cat:*)",
      "Bash(grep:*)",
      "Bash(find:*)"
    ],
    "deny": [
      "Bash(git push:*)",
      "Bash(git push --force:*)",
      "Bash(git reset --hard:*)",
      "Bash(sudo:*)",
      "Bash(rm -rf:*)",
      "Bash(chmod 777:*)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(*.token)",
      "Read(*.key)",
      "Read(*.pem)",
      "Read(**/id_rsa)",
      "Read(**/id_dsa)",
      "Read(**/.ssh/id_*)",
      "Write(.env)",
      "Write(.env.*)",
      "Write(*.token)",
      "Write(*.key)",
      "Write(*.pem)"
    ],
    "ask": [
      "Bash(git commit:*)",
      "Bash(wget:*)",
      "Bash(npm publish:*)",
      "Bash(yarn publish:*)",
      "Bash(kubectl:*)",
      "Bash(rm:*)",
      "Bash(mv:*)",
      "Bash(chmod:*)"
    ],
    "disableBypassPermissionsMode": "disable"
  },
  "enabledPlugins": {
    "asken-backend@claude-code-marketplace": true
  },
  "alwaysThinkingEnabled": true
}
